# cp .env.example .env && chmod 600 .env
#
# Здесь только НЕсекретные настройки. Токен бота, пароль БД и ключ
# шифрования анкеты лежат в ./secrets/ отдельными файлами: содержимое окружения видно
# в `docker inspect` и попадает в трейсбеки при падении.
#
#   mkdir -p secrets && chmod 700 secrets
#   printf '%s' '<токен от @BotFather>' > secrets/bot_token
#   openssl rand -hex 32 | tr -d '\n'     > secrets/db_password
#   openssl rand -base64 32 | tr -d '\n'  > secrets/pdn_key
#   chmod 600 secrets/*
#
# ВНИМАНИЕ про secrets/pdn_key. Этим ключом зашифрованы паспортные данные
# и адреса в базе. Потеряете файл - анкеты незаконченных регистраций
# прочитать будет нечем (уже выданные договоры не пострадают: они лежат
# готовыми файлами). Меняете ключ - старые анкеты становятся нечитаемыми,
# люди проходят анкету заново. Кладите ключ в тот же бэкап, что и базу,
# но НЕ в тот же архив.

# Значения берите в кавычки. Пробел внутри значения (например, два id
# в ADMINS) иначе ломает чтение файла: bootstrap.sh читает .env через
# `. ./.env`, и всё после пробела shell пытается выполнить как команду.
POSTGRES_USER="mybike"
POSTGRES_DB="mybike"
# Арендодатель в Казани (см. реквизиты оферты) - это UTC+3, Europe/Moscow.
# От TZ зависят метки в логах и время суточного прогона ретеншена.
TZ="Europe/Moscow"

# ─── Telegram ───
# Числовой id канала (-100...). Бот обязан быть его АДМИНИСТРАТОРОМ,
# иначе getChatMember не отдаст статус подписки и гейт не заработает.
CHANNEL_ID="-1001234567890"
CHANNEL_URL="https://t.me/mybike"

# Чат модерации и те, кому разрешено жать «Одобрить».
# Несколько id — через пробел или запятую, обязательно в кавычках:
#   ADMINS="111111111 222222222"
ADMIN_CHAT_ID="-1009876543210"
ADMINS="111111111"

# ─── договор ───
# Кому приходит договор на утверждение. Это ЧИСЛОВОЙ id аккаунта
# @arenda_velo_kazan, а не username: Telegram API имя не примет.
#
# Как узнать: попросите владельца аккаунта отправить боту /start (без этого
# бот не имеет права написать ему первым - таково ограничение Telegram),
# затем посмотрите id в логе: docker compose logs bot | grep tg_id
# Либо перешлите любое его сообщение боту @userinfobot.
#
# Оставите пустым - договоры пойдут в ADMIN_CHAT_ID, бот при этом работает.
CONTRACT_CHAT_ID=""
# Куда уходит ПОДПИСАННЫЙ договор. Обычно группа с темами.
FIX_CHAT_ID=""
# Номер темы «Фиксация сдачи» внутри этой группы. Как узнать: откройте тему,
# скопируйте ссылку на любое сообщение - предпоследнее число в ней и есть
# номер темы. Пусто = писать в общую ленту группы, без темы.
FIX_TOPIC_ID=""

# ─── документы ───
# Порядок в боте: ознакомление с Политикой ПДн (файл app/pdn_policy.docx,
# отдельная галочка) -> согласие на обработку ПДн -> анкета -> договор
# с приложением-согласием -> оплата -> Акт приёма-передачи.
# Ссылка на правила проката необязательна - если задана, на экране согласия
# появится кнопка «Правила проката».
OFERTA_URL=""
# Редакция согласия на обработку ПДн. Меняйте при КАЖДОЙ правке текста
# экрана согласия: версия пишется в базу вместе с моментом согласия, иначе
# не доказать, под какой редакцией человек подписался.
OFERTA_VERSION="2026-01-15"

# Веб-версия Политики обработки ПДн. Необязательна: политика и так уходит
# файлом на шаге ознакомления. Заполните - появится кнопка со ссылкой.
PDN_URL=""
# Редакция Политики ПДн и согласия. Меняйте при каждой правке
# app/pdn_policy.docx. По умолчанию берётся из OFERTA_VERSION.
PDN_VERSION=""

VIDEO_URL="https://youtu.be/CyZzskq8o0o"

# ─── оплата ───
# Ссылка на оплату по расчётному счёту (СБП QR). Бот показывает её клиенту
# на этапе оплаты, при продлении и в ответах про реквизиты - кнопкой
# «Оплатить» и текстом. Сменился счёт - поменяйте здесь и перезапустите
# бота: `docker compose up -d`. Пусто - берётся ссылка из app/faq.py.
# ВНИМАНИЕ: значение обязательно в кавычках, в ссылке есть «&».
PAY_URL="https://qr.nspk.ru/BS1A0050UAJCK8MS89CR3TLN80KF48DJ?type=01&bank=100000000284&crc=3DC0"

# ─── ретеншен ───
# Должно совпадать с тем, что написано в договоре и в тексте согласия.
PURGE_APPROVED_DAYS="90"
PURGE_REJECTED_DAYS="3"
UPDATES_LOG_DAYS="7"

# ─── витрина парка (необязательно) ───
# HTTP-порт витрины: /api/points, /api/models, /api/availability - точки,
# каталог с ценами и наличие. Данные только витринные: ни вин-номеров,
# ни людей. Нужна будущему приложению; пусто - витрина не поднимается.
# Заполнив, раскомментируйте ports у сервиса bot в docker-compose.yml.
API_PORT=""

# ─── бот в MAX (необязательно) ───
# Второй бот - в мессенджере MAX (max.ru). Запускается отдельно:
#   printf '%s' '<токен от @MasterBot>' > secrets/max_bot_token
#   docker compose --profile max up -d --build
# Пока значения пусты и профиль не включён, ничего не происходит.
# ID канала и чатов - числовые, из MAX (не из Telegram!).
MAX_CHANNEL_ID=""
MAX_CHANNEL_URL=""
MAX_ADMIN_CHAT_ID=""
MAX_ADMINS=""
MAX_CONTRACT_CHAT_ID=""
MAX_FIX_CHAT_ID=""
# Префикс номеров договоров MAX-бота: у него своя нумерация, и префикс
# не даёт двум договорам из разных мессенджеров получить одинаковый номер.
MAX_CONTRACT_PREFIX="АВМ"
# Адрес Bot API MAX. Менять только если dev.max.ru объявит другой.
MAX_API_BASE="https://botapi.max.ru"
