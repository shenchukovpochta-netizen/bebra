# cp .env.example .env && chmod 600 .env
#
# Здесь только НЕсекретные настройки. Токен бота, пароль БД и ключ
# шифрования анкеты лежат в ./secrets/ отдельными файлами: содержимое окружения видно
# в `docker inspect` и попадает в трейсбеки при падении.
#
#   mkdir -p secrets && chmod 700 secrets
#   printf '%s' '<токен от @BotFather>' > secrets/bot_token
#   openssl rand -hex 32 | tr -d '\n'     > secrets/db_password
#   openssl rand -base64 32 | tr -d '\n'  > secrets/pdn_key
#   chmod 600 secrets/*
#
# ВНИМАНИЕ про secrets/pdn_key. Этим ключом зашифрованы паспортные данные
# и адреса в базе. Потеряете файл - анкеты незаконченных регистраций
# прочитать будет нечем (уже выданные договоры не пострадают: они лежат
# готовыми файлами). Меняете ключ - старые анкеты становятся нечитаемыми,
# люди проходят анкету заново. Кладите ключ в тот же бэкап, что и базу,
# но НЕ в тот же архив.

# Значения берите в кавычки. Пробел внутри значения (например, два id
# в ADMINS) иначе ломает чтение файла: bootstrap.sh читает .env через
# `. ./.env`, и всё после пробела shell пытается выполнить как команду.
POSTGRES_USER="mybike"
POSTGRES_DB="mybike"
# Арендодатель в Казани (см. реквизиты оферты) - это UTC+3, Europe/Moscow.
# От TZ зависят метки в логах и время суточного прогона ретеншена.
TZ="Europe/Moscow"
# Сколько дней хранить ежедневные дампы базы в ./backups (сервис backup).
BACKUP_KEEP_DAYS="30"

# ─── Telegram ───
# Числовой id канала (-100...). Бот обязан быть его АДМИНИСТРАТОРОМ,
# иначе getChatMember не отдаст статус подписки и гейт не заработает.
CHANNEL_ID="-1001234567890"
CHANNEL_URL="https://t.me/mybike"

# Чат модерации и те, кому разрешено жать «Одобрить».
# Несколько id — через пробел или запятую, обязательно в кавычках:
#   ADMINS="111111111 222222222"
ADMIN_CHAT_ID="-1009876543210"
ADMINS="111111111"

# ─── договор ───
# Кому приходит договор на утверждение. Это ЧИСЛОВОЙ id аккаунта
# @arenda_velo_kazan, а не username: Telegram API имя не примет.
#
# Как узнать: попросите владельца аккаунта отправить боту /start (без этого
# бот не имеет права написать ему первым - таково ограничение Telegram),
# затем посмотрите id в логе: docker compose logs bot | grep tg_id
# Либо перешлите любое его сообщение боту @userinfobot.
#
# Оставите пустым - договоры пойдут в ADMIN_CHAT_ID, бот при этом работает.
CONTRACT_CHAT_ID=""
# Куда уходит ПОДПИСАННЫЙ договор. Обычно группа с темами.
FIX_CHAT_ID=""
# Номер темы «Фиксация сдачи» внутри этой группы. Как узнать: откройте тему,
# скопируйте ссылку на любое сообщение - предпоследнее число в ней и есть
# номер темы. Пусто = писать в общую ленту группы, без темы.
FIX_TOPIC_ID=""

# ─── документы ───
# Порядок в боте: ознакомление с Политикой ПДн (файл app/pdn_policy.docx,
# отдельная галочка) -> согласие на обработку ПДн -> анкета -> договор
# с приложением-согласием -> оплата -> Акт приёма-передачи.
# Ссылка на правила проката необязательна - если задана, на экране согласия
# появится кнопка «Правила проката».
OFERTA_URL=""
# Редакция согласия на обработку ПДн. Меняйте при КАЖДОЙ правке текста
# экрана согласия: версия пишется в базу вместе с моментом согласия, иначе
# не доказать, под какой редакцией человек подписался.
OFERTA_VERSION="2026-01-15"

# Веб-версия Политики обработки ПДн. Необязательна: политика и так уходит
# файлом на шаге ознакомления. Заполните - появится кнопка со ссылкой.
PDN_URL=""
# Редакция Политики ПДн и согласия. Меняйте при каждой правке
# app/pdn_policy.docx. По умолчанию берётся из OFERTA_VERSION.
PDN_VERSION=""

VIDEO_URL="https://youtu.be/CyZzskq8o0o"

# ─── оплата ───
# Ссылка на оплату по расчётному счёту (СБП QR). Бот показывает её клиенту
# на этапе оплаты, при продлении и в ответах про реквизиты - кнопкой
# «Оплатить» и текстом. Сменился счёт - поменяйте здесь и перезапустите
# бота: `docker compose up -d`. Пусто - берётся ссылка из app/faq.py.
# ВНИМАНИЕ: значение обязательно в кавычках, в ссылке есть «&».
PAY_URL="https://qr.nspk.ru/BS1A0050UAJCK8MS89CR3TLN80KF48DJ?type=01&bank=100000000284&crc=3DC0"

# ─── ретеншен ───
# Должно совпадать с тем, что написано в договоре и в тексте согласия.
PURGE_APPROVED_DAYS="90"
PURGE_REJECTED_DAYS="3"
UPDATES_LOG_DAYS="7"

# ─── напоминания о сроке аренды ───
# За сколько дней до конца предупредить клиента и в котором часу (UTC)
# слать напоминания и сводку оператору. 7 UTC = 10:00 по Казани.
REMIND_BEFORE_DAYS="2"
REMIND_HOUR_UTC="7"

# ─── бот в MAX (необязательно) ───
# Второй бот - в мессенджере MAX (max.ru). Запускается отдельно:
#   printf '%s' '<токен от @MasterBot>' > secrets/max_bot_token
#   docker compose --profile max up -d --build
# Пока значения пусты и профиль не включён, ничего не происходит.
# ID канала и чатов - числовые, из MAX (не из Telegram!).
MAX_CHANNEL_ID=""
MAX_CHANNEL_URL=""
MAX_ADMIN_CHAT_ID=""
MAX_ADMINS=""
MAX_CONTRACT_CHAT_ID=""
MAX_FIX_CHAT_ID=""
# Префикс номеров договоров MAX-бота: у него своя нумерация, и префикс
# не даёт двум договорам из разных мессенджеров получить одинаковый номер.
MAX_CONTRACT_PREFIX="АВМ"
# Адрес Bot API MAX. Менять только если dev.max.ru объявит другой.
MAX_API_BASE="https://botapi.max.ru"

# ─── веб-панель CRM ───
# Панель (python -m app.web, сервис crm) слушает порт CRM_PORT на адресе
# CRM_BIND. По умолчанию 127.0.0.1 - снаружи не видна, открывается через
# SSH-туннель: ssh -L 8080:127.0.0.1:8080 root@IP и http://localhost:8080.
# Есть домен - оставьте 127.0.0.1, заполните CRM_DOMAIN и поднимите
# профиль https (Caddy сам получит сертификат): см. CRM.md.
# CRM_BIND="0.0.0.0" открывает панель по голому http всему интернету -
# так делать не надо.
CRM_BIND="127.0.0.1"
CRM_PORT="8080"
# Логин первого администратора. Пароль - secrets/crm_admin_password
# (bootstrap.sh генерирует); после первого входа смените его в панели.
CRM_ADMIN_LOGIN="admin"
CRM_TITLE="МАЙБАЙК"
# Домен панели для профиля https: A-запись поддомена - на IP этого VPS
# (Beget: «Домены и поддомены» -> добавить crm.mybike-kzn.ru -> «Направить
# на сайт или VPS»). Основной mybike-kzn.ru остаётся под сайт. Пусто -
# панель только через SSH-туннель.
CRM_DOMAIN="crm.mybike-kzn.ru"
# Профили compose, которые поднимаются при любом `docker compose up -d`:
# https - Caddy с сертификатом для CRM_DOMAIN; max - бот в MAX; demo -
# демо-стенд (ниже), через запятую: "https,max". Без этой строки после
# обновления (down/up) HTTPS молча пропадал бы - Caddy поднимается
# только в своём профиле.
COMPOSE_PROFILES="https"
# Кому верить по X-Forwarded-For, когда панель стоит за прокси. Пусто -
# частные сети, в которых живёт compose (Caddy приходит оттуда). Менять
# нужно только со своим прокси в другой сети; «*» здесь ставить нельзя -
# uvicorn берёт ПЕРВЫЙ адрес из заголовка, и клиент, дописавший свой,
# подставил бы в протокол подписи выдуманный адрес.
CRM_TRUSTED_PROXIES=""

# ─── демо-стенд для франшизы (необязательно) ───
# Копия панели на вымышленных данных: покупатель франшизы входит под
# demo / demo и видит живую систему. Своя база (postgres-demo) и свои
# секреты (secrets/demo_db_password и secrets/crm_demo_secret создаёт
# bootstrap.sh); к боевой базе, боту и банку у демо доступа нет. Данные
# пересеиваются при старте и каждую ночь в 04:00 по Москве.
# Адрес - отдельный поддомен, A-запись на IP этого VPS, например
# demo.mybike-kzn.ru. Задан - install.sh добавит профили demo и https в
# COMPOSE_PROFILES, bootstrap.sh откроет 80/443. Пусто - демо нет.
DEMO_DOMAIN=""
# Порт демо на сервере для SSH-туннеля, пока нет домена:
# ssh -L 8081:127.0.0.1:8081 root@IP и http://localhost:8081.
# Как и у панели, "0.0.0.0" открыл бы демо по голому http - не надо.
DEMO_BIND="127.0.0.1"
DEMO_PORT="8081"

# ─── трекеры StarLine ───
# Где сейчас велосипед. Пусто - опрос не запускается, раздел «Карта»
# показывает пустую карту, всё остальное работает как раньше.
# appId приложения из личного кабинета StarLine (developer.starline.ru),
# логин - тот же, которым вы входите в кабинет. Секрет приложения и
# пароль - файлами: secrets/starline_app_secret и secrets/starline_password.
STARLINE_APP_ID=""
STARLINE_LOGIN=""
# Как часто спрашивать StarLine о позициях, секунд. Чаще 300 смысла нет:
# устройство и само присылает точку примерно раз в пять минут.
STARLINE_POLL_SECONDS="300"

# ─── счёт в Точке ───
# Выписка по счёту (раздел «Касса → Выписка») и чек 54-ФЗ в ссылке на
# оплату. Пусто - выписка не тянется, клиент платит по обычной ссылке
# PAY_URL, а чеки пробиваются как раньше.
# Токен - в secrets/tochka_token (личный кабинет банка, «Интеграции»).
# accountId выглядит как «40802810XXXXXXXXXXXX/044525104», customerCode -
# код клиента банка; оба видны в ответе /open-banking/v1.0/accounts.
# Счетов может быть несколько - через запятую: выписка берётся по каждому.
TOCHKA_ACCOUNT_ID=""
TOCHKA_CUSTOMER_CODE=""
# Как часто тянуть выписку, секунд. Полчаса: клиент, оплативший утром,
# не должен ждать выдачи до вечера.
TOCHKA_POLL_SECONDS="1800"
# Эквайринг работает от тех же TOCHKA_TOKEN и TOCHKA_CUSTOMER_CODE:
# панель по кнопке оператора просит ссылку на оплату с чеком, процесс
# бота раз в минуту спрашивает банк, оплатили ли её.
#
# Автосписание с сохранённой карты включается в панели («Финансы →
# Счета»), а не здесь: это чужая карта. Банк включает рекуррентные
# платежи магазину отдельно - пока он их не включил, первая же попытка
# вернёт отказ, и его текст будет виден на счёте.

# ─── Авито (сообщения) ───
# Чаты объявлений приходят в раздел панели «Входящие», ответ оттуда уходит
# в тот же чат Авито. Ключи - «Для профессионалов → API» в кабинете
# ОСНОВНОГО аккаунта компании (ключ сотрудника чатов компании не видит):
# client_id здесь, client_secret - файлом secrets/avito_client_secret.
# Нужен тариф с доступом к API сообщений («Расширенный» или выше) - без
# него Авито отвечает 402, и панель показывает это плашкой. Пусто -
# опрос выключен.
AVITO_CLIENT_ID=""
# Как часто спрашивать Авито о новых сообщениях, секунд (не чаще 30).
AVITO_POLL_SECONDS="60"

# ─── Входящие (раздел панели) ───
# Переменных здесь нет - только файлы секретов. secrets/inbox_key шифрует
# переписку (bootstrap.sh создаёт его сам). secrets/inbox_hook_token -
# токен адреса https://<CRM_DOMAIN>/hook/inbox для шлюза WhatsApp
# (Green-API, Wazzup) или n8n: openssl rand -hex 32 > secrets/inbox_hook_token,
# затем docker compose restart crm. Пустой файл - хука нет. Подробности -
# CRM.md, «Входящие».

# ─── Рабочая группа точек (бывший сценарий n8n) ───
# Бот читает темы группы и сверяет формы с базой: фиксация выдачи и
# «ЗАМЕНА», сдача, проверка долга по номеру, поиск трекера, итоги дня
# сервиса. 👍 - совпало с CRM, 👎 - нет, ответом сказано, что. Пусто -
# группа не читается. Бот должен быть АДМИНИСТРАТОРОМ группы: иначе
# Telegram отдаёт ему только команды, а не формы. Сценарий n8n на той же
# группе выключить - иначе каждое сообщение разберут дважды.
OPS_CHAT_ID=""
# Номера тем - из ссылки на сообщение темы: https://t.me/c/2631509993/7/123
# это тема 7. Тема без номера не читается.
OPS_TOPIC_FIX="7"
OPS_TOPIC_RETURN="2383"
OPS_TOPIC_DEBT="23488"
OPS_TOPIC_GPS="23745"
OPS_TOPIC_DAILY="604"
