# cp .env.example .env && chmod 600 .env
#
# Здесь только НЕсекретные настройки. Токен бота, пароль БД и ключ OCR
# лежат в ./secrets/ отдельными файлами: содержимое окружения видно
# в `docker inspect` и попадает в трейсбеки при падении.
#
#   mkdir -p secrets && chmod 700 secrets
#   printf '%s' '<токен от @BotFather>' > secrets/bot_token
#   openssl rand -hex 32 | tr -d '\n'     > secrets/db_password
#   printf '%s' '<Api-Key Yandex Vision>' > secrets/ocr_api_key   # пустой файл = OCR выключен
#   chmod 600 secrets/*

POSTGRES_USER=mybike
POSTGRES_DB=mybike
# Арендодатель в Казани (см. реквизиты оферты) - это UTC+3, Europe/Moscow.
# От TZ зависят метки в логах и время суточного прогона ретеншена.
TZ=Europe/Moscow

# ─── Telegram ───
# Числовой id канала (-100...). Бот обязан быть его АДМИНИСТРАТОРОМ,
# иначе getChatMember не отдаст статус подписки и гейт не заработает.
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/mybike

# Чат модерации и те, кому разрешено жать «Одобрить» (через пробел или запятую)
ADMIN_CHAT_ID=-1009876543210
ADMINS=111111111

# ─── документы ───
# Публичная оферта вместе с Правилами проката. Открывается без авторизации.
OFERTA_URL=https://example.ru/oferta
# Меняйте при КАЖДОЙ правке текста оферты: версия пишется в базу вместе
# с моментом согласия, иначе не доказать, под какой редакцией человек подписался.
OFERTA_VERSION=2026-01-15

# Отдельная политика обработки ПДн. Пусто = согласие берётся внутри оферты
# одним экраном. Заполните, если опубликуете политику отдельным документом -
# тогда на экране согласия появится вторая кнопка.
PDN_URL=
# По умолчанию берётся из OFERTA_VERSION
PDN_VERSION=

VIDEO_URL=https://youtu.be/CyZzskq8o0o

# ─── OCR ───
OCR_ENABLED=1
OCR_FOLDER_ID=b1g...
# Обработчик называется в тексте согласия на ПДн. При переходе на on-premise
# SDK замените строку - и уберите упоминание передачи из политики.
# Кавычки обязательны: без них скобки и пробелы делают строку синтаксической
# ошибкой для shell, и bootstrap.sh обрывает чтение .env на этом месте.
OCR_PROCESSOR="ООО «ЯНДЕКС.ОБЛАКО» (распознавание, Россия)"

# ─── ретеншен ───
# Должно совпадать с тем, что написано в политике обработки ПДн.
PURGE_APPROVED_DAYS=90
PURGE_REJECTED_DAYS=3
UPDATES_LOG_DAYS=7
